---
interface Props {
	id: string;
	label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="flex flex-wrap gap-x-8 gap-y-4 border-t border-rule py-[clamp(48px,8vw,72px)]">
	<div class="flex-[0_0_200px]">
		<h2 class="pt-[5px] font-mono text-xs leading-4 font-medium tracking-[0.06em] text-ink-muted uppercase">{label}</h2>
	</div>
	<div class="min-w-0 flex-[999_1_400px]">
		<slot />
	</div>
</section>
